# X API credentials (read-only)
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_BEARER_TOKEN=your_bearer_token_here

# LLM API
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Budget limits
DAILY_SPEND_LIMIT_USD=5.00
DAILY_INFERENCE_LIMIT_USD=10.00

# Max output tokens per inference call (sent as max_completion_tokens; sizes the
# budget reservation). Raise them before switching to a reasoning model.
RESEARCH_MAX_OUTPUT_TOKENS=1500
PLAN_MAX_OUTPUT_TOKENS=400
DRAFT_MAX_OUTPUT_TOKENS=400
CHECK_MAX_OUTPUT_TOKENS=600
# Brief suggestions from the product page (issue #42)
SUGGEST_MAX_OUTPUT_TOKENS=1500
SUGGEST_MAX_PAGE_BYTES=60000

# Draft mode: assembled (fixed phrases plus one verbatim brief sentence, the
# default) or written (the model writes the reply; product claims are checked
# against the brief; needs a watch started with a product name). See
# docs/DEVELOPMENT.md, "Draft modes".
DRAFT_MODE=assembled

# X API pricing (per resource)
X_POST_READ_COST=0.005
X_USER_READ_COST=0.010
X_POST_CREATE_COST=0.015

# Database
DATABASE_URL=sqlite:///./x_conversation_finder.db
